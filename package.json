{
  "name": "face-whisper",
  "private": true,
  "version": "0.1.0",
  "description": "Quiet, on-device reminders of who someone is, for people with face blindness.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/copy-models.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "vite build && playwright test --project=e2e",
    "demo:record": "vite build && playwright test --project=record",
    "fake-camera": "bash scripts/make-fake-camera.sh"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@vladmandic/face-api": "^1.7.15",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "author": "Harsh Bhanushali"
}
