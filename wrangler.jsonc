{
  // Halo on Cloudflare: one Worker serves the built site (dist/) at the domain root and,
  // only for /api/*, the optional Enhanced mode. Build first (npm run build). Deploy steps
  // are in worker/README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "halo.dualmindlab.tech", "custom_domain": true }],
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "RL", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "vars": { "APP_ORIGIN": "https://halo.dualmindlab.tech", "DAILY_LIMIT": "2000" },
  // No request content is logged anywhere.
  "observability": { "enabled": false }
}
