{
  // Halo on Cloudflare Workers static assets: the built site in dist/, served at the domain root.
  // Build first (npm run build), then deploy with `npx wrangler deploy`. Not deployed from this repo's scripts.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
